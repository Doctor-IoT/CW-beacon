/**
 * @brief Handle POST to /applysettings — validate the admin password and
 *        save all form fields to EEPROM if authentication succeeds.
 */
void handle_applysettings() {
  // Parse all form fields from the HTTP POST body
  sysname       = server.arg("system_name");
  wifissid      = server.arg("wifi_ssid");
  wifipwd       = server.arg("wifi_pwd");
  String ip0    = server.arg("staip_0");
  String ip1    = server.arg("staip_1");
  String ip2    = server.arg("staip_2");
  String ip3    = server.arg("staip_3");
  String nm0    = server.arg("netm_0");
  String nm1    = server.arg("netm_1");
  String nm2    = server.arg("netm_2");
  String nm3    = server.arg("netm_3");
  String dg0    = server.arg("defg_0");
  String dg1    = server.arg("defg_1");
  String dg2    = server.arg("defg_2");
  String dg3    = server.arg("defg_3");
  String dn00   = server.arg("dns0_0");
  String dn01   = server.arg("dns0_1");
  String dn02   = server.arg("dns0_2");
  String dn03   = server.arg("dns0_3");
  String dn10   = server.arg("dns1_0");
  String dn11   = server.arg("dns1_1");
  String dn12   = server.arg("dns1_2");
  String dn13   = server.arg("dns1_3");
  String botena = server.arg("bot_ena");
  String temp_token = server.arg("bot_token");
  String userid0    = server.arg("user_id0");
  String userid1    = server.arg("user_id1");
  String userid2    = server.arg("user_id2");
  String userid3    = server.arg("user_id3");
  String ppmthr     = server.arg("ppm_thr");   // Reserved
  String toff       = server.arg("t_off");      // Reserved
  String httpsena   = server.arg("https_ena");  // Reserved

  // Validate and parse the WPM field
  String wpm    = server.arg("get_wpm");
  float  temp   = wpm.toFloat();
  if (temp > 0 && temp <= 30) {
    wpms[0] = temp;
  }

  message = server.arg("get_mes");
  qrz     = server.arg("get_qrz");
  qrg     = server.arg("get_qrg");

  // Validate the calibration factor (must be within ±10000 Hz)
  String fcal   = server.arg("get_cal");
  long   temp1  = fcal.toInt();
  if (-10000 < temp1 && temp1 < 10000) {
    cal_factor = temp1;
  }
  else {
    fcal = String(cal_factor);  // Out-of-range: keep the current value
  }
  cal_factor = fcal.toInt();

  bgcolor  = server.arg("bg_col");
  String getpwd1 = server.arg("get_pwd1");
  String getpwd2 = server.arg("get_pwd2");
  admpwd         = server.arg("adm_pwd");

  // In admin mode, echo all received parameters to the serial monitor for debugging
  if (ADMIN) {
    Serial.print("Sysname from web: ");       Serial.println(sysname);
    Serial.print("WiFi ssid from web: ");     Serial.println(wifissid);
    Serial.print("WiFi pwd from web: ");      Serial.println(wifipwd);
    Serial.print("Static IP from web: ");     Serial.println(ip0 + " " + ip1 + " " + ip2 + " " + ip3);
    Serial.print("Netmask from web: ");       Serial.println(nm0 + " " + nm1 + " " + nm2 + " " + nm3);
    Serial.print("Default GW from web: ");    Serial.println(dg0 + " " + dg1 + " " + dg2 + " " + dg3);
    Serial.print("Primary DNS from web: ");   Serial.println(dn00 + " " + dn01 + " " + dn02 + " " + dn03);
    Serial.print("Secondary DNS from web: "); Serial.println(dn10 + " " + dn11 + " " + dn12 + " " + dn13);
    Serial.print("TG bot enable from web: "); Serial.println(botena);
    Serial.print("TG token from web: ");      Serial.println(temp_token);
    Serial.print("User id0 from web: ");      Serial.println(userid0);
    Serial.print("User id1 from web: ");      Serial.println(userid1);
    Serial.print("User id2 from web: ");      Serial.println(userid2);
    Serial.print("User id3 from web: ");      Serial.println(userid3);
    Serial.print("Cal. Factor from web: ");   Serial.println(fcal);
    Serial.print("Message from web: ");       Serial.println(message);
    Serial.print("QRZ from web: ");           Serial.println(qrz);
    Serial.print("QRG from web: ");           Serial.println(qrg);
    Serial.print("BG color from web: ");      Serial.println(bgcolor);
    Serial.print("New pwd1 from the web: ");  Serial.println(getpwd1);
    Serial.print("New pwd2 from the web: ");  Serial.println(getpwd2);
    Serial.print("Admin pwd from web: ");     Serial.println(admpwd);
  }

  // ── Authentication and EEPROM save ──────────────────────────────────────
  if (admpwd == adminpwd) {
    // Correct admin password — persist all settings to EEPROM
    saveString2eeprom(sysname,    sysNameAdr,  sysNameLen);
    saveString2eeprom(wifissid,   APssidAdr,   APssidLen);
    saveString2eeprom(wifipwd,    APpwdAdr,    APpwdLen);

    // Static IP: each octet stored as a single byte
    saveByte2eeprom(ip0.toInt() & 0xFF, staticIpAdr);
    saveByte2eeprom(ip1.toInt() & 0xFF, staticIpAdr + 1);
    saveByte2eeprom(ip2.toInt() & 0xFF, staticIpAdr + 2);
    saveByte2eeprom(ip3.toInt() & 0xFF, staticIpAdr + 3);

    saveByte2eeprom(nm0.toInt() & 0xFF, netMaskAdr);
    saveByte2eeprom(nm1.toInt() & 0xFF, netMaskAdr + 1);
    saveByte2eeprom(nm2.toInt() & 0xFF, netMaskAdr + 2);
    saveByte2eeprom(nm3.toInt() & 0xFF, netMaskAdr + 3);

    saveByte2eeprom(dg0.toInt() & 0xFF, gatewayIpAdr);
    saveByte2eeprom(dg1.toInt() & 0xFF, gatewayIpAdr + 1);
    saveByte2eeprom(dg2.toInt() & 0xFF, gatewayIpAdr + 2);
    saveByte2eeprom(dg3.toInt() & 0xFF, gatewayIpAdr + 3);

    // sensorsEnableAdr byte: bit0 = Telegram bot enable
    char val = 0;
    if (botena == "1") val += 1;
    saveByte2eeprom(val, sensorsEnableAdr);

    saveByte2eeprom(dn00.toInt() & 0xFF, dnsIp0Adr);
    saveByte2eeprom(dn01.toInt() & 0xFF, dnsIp0Adr + 1);
    saveByte2eeprom(dn02.toInt() & 0xFF, dnsIp0Adr + 2);
    saveByte2eeprom(dn03.toInt() & 0xFF, dnsIp0Adr + 3);
    saveByte2eeprom(dn10.toInt() & 0xFF, dnsIp1Adr);
    saveByte2eeprom(dn11.toInt() & 0xFF, dnsIp1Adr + 1);
    saveByte2eeprom(dn12.toInt() & 0xFF, dnsIp1Adr + 2);
    saveByte2eeprom(dn13.toInt() & 0xFF, dnsIp1Adr + 3);

    // Telegram user IDs are stored as 8-byte big-endian uint64_t values
    uint64_t tempval;
    tempval = Str2u64(userid0); saveU64eeprom(tempval, user0Adr);
    tempval = Str2u64(userid1); saveU64eeprom(tempval, user1Adr);
    tempval = Str2u64(userid2); saveU64eeprom(tempval, user2Adr);
    tempval = Str2u64(userid3); saveU64eeprom(tempval, user3Adr);

    saveString2eeprom(temp_token, tokenAdr,   tokenLen);
    saveString2eeprom(fcal,       fcalAdr,    fcalLen);
    saveString2eeprom(message,    messageAdr, messageLen);
    saveString2eeprom(qrz,        qrzAdr,     qrzLen);
    saveString2eeprom(qrg,        qrgAdr,     qrgLen);
    saveString2eeprom(wpm,        wpmAdr,     wpmLen);
    saveString2eeprom(bgcolor,    bgcolorAdr, bgcolorLen);

    // Change the admin password if both new-password fields match and are ≥8 chars
    if (getpwd1 == getpwd2 && getpwd1.length() > 7) {
      saveString2eeprom(getpwd1, admPwdAdr, admPwdLen);
      EEPROM.begin(EEmemLen);
      EEPROM.write(pwdChangedAdr, '1');  // Mark password as changed
      EEPROM.end();
    }

    SendHTMLchunked(2);  // "Settings applied" confirmation page
  }
  else {
    SendHTMLchunked(3);  // "Wrong password" error page
  }
}

/** @brief Serve the status page on the root route "/" */
void handle_OnConnect() {
  SendHTMLchunked(0);
}

/**
 * @brief Handle POST to /restart — verify the hidden token and reboot.
 *
 * The hidden form field "res_req" must equal "1978" (set by page 2).
 * This prevents accidental reboot by a direct GET to /restart.
 */
void handle_restart() {
  String resreq = server.arg("res_req");
  if (resreq == "1978") {
    server.sendHeader("Cache-Control", "no-cache, no-store, must-revalidate");
    server.sendHeader("Pragma", "no-cache");
    server.sendHeader("Expires", "-1");
    server.setContentLength(CONTENT_LENGTH_UNKNOWN);
    server.send(200, "text/html", "");
    // Auto-redirect to the root page after 5 seconds (by which time the reboot is done)
    server.sendContent(F("<!DOCTYPE html><html><head>"
                         "<meta http-equiv=\"refresh\" content=\"5; url='/'\" />"
                         "</head><body><p>Wait while rebooting..</p></body></html>"));
    server.sendContent(F(""));
    server.client().stop();
    ESP.restart();
  }
  else {
    // Invalid token — reject the request and redirect to the home page
    server.sendHeader("Cache-Control", "no-cache, no-store, must-revalidate");
    server.sendHeader("Pragma", "no-cache");
    server.sendHeader("Expires", "-1");
    server.setContentLength(CONTENT_LENGTH_UNKNOWN);
    server.send(200, "text/html", "");
    server.sendContent(F("<!DOCTYPE html><html><head>"
                         "<meta http-equiv=\"refresh\" content=\"3; url='/'\" />"
                         "</head><body><p>This request is not allowed!</p></body></html>"));
    server.sendContent(F(""));
    server.client().stop();
  }
}

