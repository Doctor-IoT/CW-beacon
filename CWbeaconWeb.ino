/**
 * UTC timestamp string used as the first input to the CRC function.
 * Format: "yymmddhhmm" (10 characters, zero-padded).
 * Updated from NTP before each transmission in SetBeaconMsg().
 * Default value is a placeholder used before the first NTP sync.
 */
String timeStamp = "2414101700";

/**
 * CRC salt — Marconi's birthday: April 25, 1874.
 * The Fletcher-16 checksum is computed over (timeStamp + salt).
 * Any receiving station that knows this salt and the current UTC time
 * can independently verify the 4-hex CRC appended to each transmission,
 * confirming the beacon's identity and timing.
 */
String salt = "25041874";

