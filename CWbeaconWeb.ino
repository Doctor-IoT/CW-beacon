// ═════════════════════════════════════════════════════════════════════════════
// SETUP
// ═════════════════════════════════════════════════════════════════════════════
void setup() {
  restartReq = 0;

  // Configure the status LED / RF key line as a digital output
  pinMode(LED, OUTPUT);

  Serial.begin(115200);
  Serial.println("");

  // Flush any bytes that may have arrived in the serial buffer during boot
  while (Serial.available() > 0) {
    Serial.read();
  }

  RxDataSer.reserve(32); // Pre-allocate serial receive buffer to avoid heap fragmentation

  Serial.println(firmwareRev);

  // Print the cause of the last reset to help diagnose unexpected reboots
  rst_info *resetInfo;
  resetInfo = ESP.getResetInfoPtr();
  Serial.print("Reset reason: ");
  Serial.println(resetInfo->reason);

  varPreset();       // Load all configuration from EEPROM into RAM variables
  wifiConnection();  // Connect to Wi-Fi in STA mode (or start AP if STA fails)

  // NTP and Telegram are only initialized when running in STA (connected) mode.
  // In AP mode neither NTP nor Telegram can reach the internet.
  if (APmodeON == 0) {
    // Start the NTP client and perform the first time synchronization
    timeClient.begin();
    timeClient.update();

    // Synchronize the system clock so BearSSL can validate the Telegram TLS certificate.
    // configTime() uses POSIX timezone strings and multiple NTP server fallbacks.
    configTime(MYTZ, "time.google.com", "time.windows.com", "pool.ntp.org");

    // Configure BearSSL session resumption and certificate trust for the Telegram bot
    clientBot.setSession(&session);
    clientBot.setTrustAnchors(&certificate);
    clientBot.setBufferSizes(1024, 1024);

    if (TGbotEnable == true) {
      myBot.setUpdateTime(5000);  // Poll Telegram servers every 5 seconds
      const char* secretToken = token.c_str();
      myBot.setTelegramToken(secretToken);

      Serial.print("\nTest Telegram connection... ");
      myBot.begin() ? Serial.println("OK") : Serial.println("NOK");

      Serial.print("Bot name: @");
      Serial.println(myBot.getBotName());

      // Notify the admin user that the bot has (re)started
      if (userid[0] > 10000) {
        myBot.sendTo(userid[0], "Bot started!");
      }
    }

    // Compose the initial beacon message and initialize the Si5351A
    if (BeaconON) {
      SetBeaconMsg();
    }
  }
}


// ═════════════════════════════════════════════════════════════════════════════
// MAIN LOOP
// ═════════════════════════════════════════════════════════════════════════════
void loop() {
  // ── NON-BLOCKING MORSE SENDER ────────────────────────────────────────────
  // continueSending() checks millis() internally and toggles the LED / Si5351A
  // output as needed. It must be called as often as possible (every few ms) to
  // produce a clean, accurate Morse fist. It returns false when the complete
  // message has been sent.
  if (APmodeON == 0) {
    if (BeaconON == 1) {    // Beacon is enabled — transmit
      if (!cwtx.continueSending()) {   // Current message finished
        if (morseInProgress == 1) {
          countdown2tx = TXPAUSE;  // Start the inter-transmission gap countdown
          morseInProgress = 0;
        }
        if (countdown2tx == 0) {
          // Advance to the next speed step (cycles through wpms[] array)
          if (++speedIndex >= NUM_SPEEDS) {
            speedIndex = 0;
            SetBeaconMsg();     // Recompose message with updated CRC and re-init Si5351A
          }
          cwtx.setWPM(wpms[speedIndex]);
          cwtx.startSending(); // Begin sending from the first character of the message
        }
      }
      else {    // Morse transmission is still in progress
        morseInProgress = 1;
      }
    }
    else {      // Beacon is disabled — ensure the RF carrier and LED are off
      if (morseInProgress == 1) {
        digitalWrite(LED, LOW);
        beacon.output_enable(SI5351_CLK0, 0);
        morseInProgress = 0;
      }
    }
  }

  // ── HTTP SERVER ──────────────────────────────────────────────────────────
  server.handleClient(); // Process any pending HTTP requests from browser clients

  // ── 1-SECOND TICK ───────────────────────────────────────────────────────
  timeSample = millis();
  if ((timeSample - lastSampleData) >= 1000) {
    // Decrement the inter-transmission gap countdown (stops at 0)
    if (countdown2tx > 0) {
      countdown2tx--;
    }

    rssi = WiFi.RSSI(); // Refresh the RSSI reading once per second

    lastSampleData += 1000;

    if (APmodeON == 0) {
      // Keep the NTP time synchronized (the library resyncs automatically
      // based on ntpUpdateInterval; this call is essentially a no-op most ticks)
      timeClient.update();
      epochTime = timeClient.getEpochTime();

      // Process incoming Telegram messages (if the bot is enabled and connected)
      if (TGbotEnable) {
        if (WiFi.status() == WL_CONNECTED) {
          handleBotMessages();
        }
      }

      // Deferred restart: wait until there is no pending Telegram reply,
      // then reboot (triggered by the /reboot Telegram command)
      if (restartReq == 1) {
        if (myBot.noNewMessage()) {
          restartReq = 0;
          ESP.restart();
        }
      }


    }
  }

  // ── SERIAL CONSOLE ───────────────────────────────────────────────────────
  // Accumulate incoming serial bytes into RxDataSer; process when newline received
  while (Serial.available()) {
    char b = Serial.read();
    RxDataSer += b;
    if (b == '\n') {
      ProcessRxDataSer();
      RxDataSer = "";
    }
  }
}


// ═════════════════════════════════════════════════════════════════════════════
// TELEGRAM BOT MESSAGE HANDLER
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Process one incoming Telegram message (if any).
 *
 * Called once per second from loop(). Checks for a new message, validates
 * the sender's user ID against the authorized list, and dispatches the
 * appropriate command.
 *
 * Supported commands:
 *   /help      — Print all available commands
 *   /stat      — Beacon status: message, frequency, speed, uptime, RSSI, IP
 *   /beaconon  — Enable the RF transmitter
 *   /beaconoff — Disable the RF transmitter
 *   /getqrg    — Report the current carrier frequency (Hz)
 *   /getcal    — Report the current frequency calibration factor
 *   /getmsg    — Report the current QTC text payload
 *   /getqrz    — Report the current call sign
 *   /getspd    — Report the current Morse speed (WPM)
 *   /info      — Report the firmware revision string
 *   /reboot    — Request a graceful reboot
 *   /setqrg N  — Set carrier frequency to N Hz (saves to EEPROM)
 *   /setcal N  — Set frequency calibration factor to N (saves to EEPROM)
 *   /setmsg T  — Set the QTC text to T (max 32 chars, saves to EEPROM)
 *   /setqrz C  — Set the call sign to C (max 16 chars, saves to EEPROM)
 *   /setspd W  — Set the Morse speed to W WPM (0 < W ≤ 30, saves to EEPROM)
 */
void handleBotMessages(void)
{
  if (myBot.getNewMessage(msg)) {
    sender = msg.chatId;  // Numeric user ID of the message sender

    // Authorize: only pre-configured user IDs may send commands
    if (userid[0] == sender || userid[1] == sender ||
        userid[2] == sender || userid[3] == sender)
    {
      String msgText = msg.text;
      String reply;

      if (msgText.equals("/help")) {
        reply  = "Available commands:";
        reply += "\n/beaconon\tBeacon ON";
        reply += "\n/beaconoff\tBeacon OFF";
        reply += "\n/getqrg\tQRG of the beacon";
        reply += "\n/getcal\tQRG Calibration factor";
        reply += "\n/getmsg\tQTC of the beacon";
        reply += "\n/getqrz\tQRZ of the beacon";
        reply += "\n/getspd\tWord per minute";
        reply += "\n/info\tFirmware info";
        reply += "\n/reboot\tSystem restart";
        reply += "\n/setqrg\tSet the QRG of the beacon";
        reply += "\n/setcal\tSet the QRG calibration factor";
        reply += "\n/setmsg\tSet the QTC, max 32 chars";
        reply += "\n/setqrz\tSet the QRZ, max 16 chars";
        reply += "\n/setspd\tWord per minute";
        reply += "\n/stat\tStatus of the beacon";
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/stat")) {
        // Decompose uptime (ms) into days, hours, minutes, seconds
        unsigned long uptime      = millis() / 1000;
        unsigned char uptimeDays    = uptime / 86400;
        unsigned char uptimeHours   = (uptime % 86400) / 3600;
        unsigned char uptimeMinutes = (uptime % 3600) / 60;
        unsigned char uptimeSeconds = uptime % 60;
        reply  = "Beacon message = " + cw_message + "\n";
        reply += "Beacon QRG = "     + qrg        + "\n";
        reply += "Beacon speed = "   + String(wpms[speedIndex]) + " wpm\n";
        reply += "Beacon is ";
        reply += (BeaconON) ? "ON\n" : "OFF\n";
        reply += "WiFi RSSI = "  + String(rssi) + "dBm\n";
        reply += "MAC Adr = "    + WiFi.macAddress() + "\n";
        reply += "Local IP = "   + WiFi.localIP().toString() + "\n";
        reply += "Uptime dd:hh:mm:ss = " +
                 String(uptimeDays)    + ":" +
                 String(uptimeHours)   + ":" +
                 String(uptimeMinutes) + ":" +
                 String(uptimeSeconds) + "\n";
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/beaconon")) {
        BeaconON = 1;
        myBot.sendMessage(msg, "The beacon is now ON");
      }

      else if (msgText.equals("/beaconoff")) {
        BeaconON = 0;
        myBot.sendMessage(msg, "The beacon is now OFF");
      }

      else if (msgText.equals("/getqrg")) {
        reply = "The beacon QRG is: " + qrg + " Hz";
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/getcal")) {
        reply = "The QRG cal. factor is: " + String(cal_factor);
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/getmsg")) {
        reply = "The beacon QTC is: " + message;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/getqrz")) {
        reply = "The QRZ is: " + qrz;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/getspd")) {
        reply = "Word per minute: " + String(wpms[0]);
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/info")) {
        reply = firmwareRev;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.equals("/reboot")) {
        myBot.sendMessage(msg, "Rebooting..");
        restartReq = 1;  // Defer reboot until the reply has been sent
      }

      else if (msgText.startsWith("/setqrg")) {
        // Extract the frequency value from the command (characters after "/setqrg")
        qrg = msgText.substring(7);
        target_freq = Str2u64(qrg) * 100;  // Convert Hz → centi-Hz for Si5351 API
        saveString2eeprom(qrg, qrgAdr, qrgLen);
        reply = "The new beacon QRG is: " + qrg;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.startsWith("/setcal")) {
        String fcal = msgText.substring(7);
        long temp = fcal.toInt();
        // Accept only calibration values within a reasonable range
        if (-10000 < temp && temp < 10000) {
          cal_factor = temp;
          saveString2eeprom(fcal, fcalAdr, fcalLen);
        }
        else {
          fcal = String(cal_factor);  // Reject out-of-range value; echo the current one
        }
        reply = "The QRG cal. factor is: " + fcal;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.startsWith("/setmsg")) {
        // Extract the new QTC payload (characters after "/setmsg")
        message = msgText.substring(7);
        saveString2eeprom(message, messageAdr, messageLen);
        reply = "The new beacon QTC is: " + message;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.startsWith("/setqrz")) {
        qrz = msgText.substring(7);
        saveString2eeprom(qrz, qrzAdr, qrzLen);
        reply = "The new QRZ is: " + qrz;
        myBot.sendMessage(msg, reply);
      }

      else if (msgText.startsWith("/setspd")) {
        String temp  = msgText.substring(7);
        float  temp1 = temp.toFloat();
        // Accept only positive WPM values up to 30 WPM
        if (temp1 > 0 && temp1 <= 30) {
          wpms[0] = temp1;
          saveString2eeprom(temp, wpmAdr, wpmLen);
        }
        reply = "The new wpm is: " + temp;
        myBot.sendMessage(msg, reply);
      }

      else {
        // Unrecognized command — welcome message with help hint
        reply  = "Welcome ";
        reply += msg.sender.username;
        reply += ".\nTry /help for the list of the commands.";
        myBot.sendMessage(msg, reply);
      }
    }
    else
    {
      // Message from an unauthorized sender — alert the admin user
      myBot.sendTo(userid[0], "Not allowed user: " + String(sender));
    }
  }

  // Pet the watchdog timer after processing Telegram to prevent resets
  // during the blocking TLS handshake that may occur on getNewMessage()
  ESP.wdtEnable(1000);
  ESP.wdtFeed();
}


// ═════════════════════════════════════════════════════════════════════════════
// SERIAL CONSOLE COMMAND PROCESSOR
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Process a complete line received on the serial port (115200 baud).
 *
 * Commands (type at least the first 3 characters; commands end with Enter):
 *   adm     — Toggle admin mode ON/OFF (admin mode echoes debug data)
 *   hel     — Print the list of available commands
 *   inf     — Print firmware version, network info, and chip diagnostics
 *   pwdres  — Reset the admin password to "12345678" and reboot
 *   res     — Restart the ESP8266 immediately
 *   seta<P> — Set the admin password to P (in RAM only, not persisted)
 *   setn<N> — Set and persist the system name to N
 *   setp<P> — Set and persist the Wi-Fi password to P
 *   sets<S> — Set and persist the Wi-Fi SSID to S
 *   set?    — Print current system name, SSID, and password
 */
void ProcessRxDataSer(void)
{
  switch (RxDataSer[0])
  {
    // ── adm: toggle admin mode ────────────────────────────────────────────
    case 'a':
      if (RxDataSer[1] == 'd' && RxDataSer[2] == 'm') {
        ADMIN = !ADMIN;  // Toggle admin mode
      }
      break;

    // ── hel: print command list ───────────────────────────────────────────
    case 'h':
      if (RxDataSer[1] == 'e' && RxDataSer[2] == 'l') {
        Serial.println("Available commands");
        Serial.println("\tadm\tAdmin/user mode");
        Serial.println("\tinf\tSend information about the system");
        Serial.println("\tpwdres\tReset admin password");
        Serial.println("\tres\tRestart the system");
        Serial.println("\tseta\tSet admin password");
        Serial.println("\tsetn\tSet the name of the system");
        Serial.println("\tsetp\tSet the password for the AP");
        Serial.println("\tsets\tSet the SSID of the AP");
        Serial.println("\tset?\tPrint name, password and SSID");
      }
      break;

    // ── inf: print system information ────────────────────────────────────
    case 'i':
      if (RxDataSer[1] == 'n' && RxDataSer[2] == 'f') {
        Serial.println(firmwareRev);
        Serial.print("Sys name: ");    Serial.println(sysName);
        Serial.print("AP SSID: ");     Serial.println(wifissid);
        Serial.print("AP PWD: ");      Serial.println(wifipwd);
        Serial.print("WiFi IP: ");     Serial.println(WiFi.localIP());
        Serial.print("MAC: ");         Serial.println(WiFi.macAddress());
        Serial.print("RSSI:");         Serial.print(rssi); Serial.println(" dBm");
        Serial.print("Stations connected to soft-AP = ");
        Serial.println(WiFi.softAPgetStationNum());
        Serial.print("Soft-AP IP address = ");
        Serial.println(WiFi.softAPIP());
        WiFi.printDiag(Serial);
        Serial.print("getServer: ");   Serial.println(getServer);
        Serial.print("getScript: ");   Serial.println(getScript);
        Serial.print("getPIPscr: ");   Serial.println(getPIPscr);
        // ESP8266 chip and flash diagnostics
        Serial.print("Chip ID: ");
        Serial.println(ESP.getChipId());
        Serial.print("FLASH Chip ID: ");
        Serial.println(ESP.getFlashChipId(), HEX);
        Serial.print("FLASH size B: ");
        Serial.println(ESP.getFlashChipSize());
        Serial.print("FLASH real size B: ");
        Serial.println(ESP.getFlashChipRealSize());
        Serial.print("FLASH Hz: ");
        Serial.println(ESP.getFlashChipSpeed());
        Serial.print("Sketch size x 32-bit: ");
        Serial.println(ESP.getSketchSize());
        Serial.print("Free sketch size x 32-bit: ");
        Serial.println(ESP.getFreeSketchSpace());
        Serial.print("Free heap: ");
        Serial.println(ESP.getFreeHeap());
        Serial.print("Core ver.: ");
        Serial.println(ESP.getCoreVersion());
        Serial.print("CPU MHz: ");
        Serial.println(ESP.getCpuFreqMHz());
      }
      break;

    // ── pwdres: reset admin password to factory default ──────────────────
    case 'p':
      if (RxDataSer[1] == 'w' && RxDataSer[2] == 'd' &&
          RxDataSer[3] == 'r' && RxDataSer[4] == 'e' && RxDataSer[5] == 's') {
        // Write '0' to the pwdChanged flag so varPreset() will use the default password
        EEPROM.begin(EEmemLen);
        EEPROM.write(pwdChangedAdr, '0');
        EEPROM.end();
        Serial.println("Admin password reset\nReboot..");
        delay(100);
        ESP.reset();
      }
      break;

    // ── res: restart the system ───────────────────────────────────────────
    case 'r':
      if (RxDataSer[1] == 'e' && RxDataSer[2] == 's') {
        ESP.reset();
      }
      break;

    // ── set*: set various persistent or RAM parameters ────────────────────
    case 's':
      if (RxDataSer[1] == 'e' && RxDataSer[2] == 't') {
        if (RxDataSer[3] == 'a') {
          // seta<P>: set the admin password in RAM (not written to EEPROM)
          adminpwd = "";
          char i = 0;
          while (i < 32) {
            adminpwd += RxDataSer[4 + i];
            i++;
            if (RxDataSer[4 + i] == '\n' || RxDataSer[4 + i] == '\r') break;
          }
          Serial.print("Admin PWD: "); Serial.println(adminpwd);
        }
        else if (RxDataSer[3] == 'n') {
          // setn<N>: set and persist the system name
          int i = 0;
          EEPROM.begin(EEmemLen);
          sysName = "";
          while (RxDataSer[4 + i] != '\r') {
            EEPROM.write(sysNameAdr + i, RxDataSer[4 + i]);
            sysName += RxDataSer[4 + i];
            i++;
          }
          // Pad the remaining EEPROM slots with null bytes
          while (i < sysNameLen) {
            EEPROM.write(sysNameAdr + i, 0);
            i++;
          }
          EEPROM.end();
          Serial.print("SysName: "); Serial.println(sysName);
        }
        else if (RxDataSer[3] == 'p') {
          // setp<P>: set and persist the Wi-Fi password
          int i = 0;
          EEPROM.begin(EEmemLen);
          wifipwd = "";
          while (RxDataSer[4 + i] != '\r') {
            EEPROM.write(APpwdAdr + i, RxDataSer[4 + i]);
            wifipwd += RxDataSer[4 + i];
            i++;
          }
          while (i < APpwdLen) {
            EEPROM.write(APpwdAdr + i, 0);
            i++;
          }
          EEPROM.end();
          Serial.print("WiFi pwd: "); Serial.println(wifipwd);
        }
        else if (RxDataSer[3] == 's') {
          // sets<S>: set and persist the Wi-Fi SSID
          int i = 0;
          EEPROM.begin(EEmemLen);
          wifissid = "";
          while (RxDataSer[4 + i] != '\r') {
            EEPROM.write(APssidAdr + i, RxDataSer[4 + i]);
            wifissid += RxDataSer[4 + i];
            i++;
          }
          while (i < APssidLen) {
            EEPROM.write(APssidAdr + i, 0);
            i++;
          }
          EEPROM.end();
          Serial.print("WiFi SSID: "); Serial.println(wifissid);
        }
        else if (RxDataSer[3] == '?') {
          // set?: print name, SSID, and password
          Serial.print("Sys name: "); Serial.println(sysName);
          Serial.print("AP SSID: ");  Serial.println(wifissid);
          Serial.print("AP PWD: ");   Serial.println(wifipwd);
        }
      }
      break;

    default:
      Serial.println("?? Type \"hel\" for HELP");
      break;
  }
  Serial.println("");
}


// ═════════════════════════════════════════════════════════════════════════════
// BEACON MESSAGE SETUP
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Compose the CW message and (re)initialize the Si5351A synthesizer.
 *
 * This function is called at startup and at the beginning of each transmission
 * cycle. It:
 *   1. Reads the current UTC time from the NTP client.
 *   2. Builds a 10-character timestamp string: "yymmddhhmm".
 *   3. Computes a Fletcher-16 CRC over (timeStamp + salt).
 *   4. Assembles the full CW message: "<qrz> <message> <CRC-hex>".
 *   5. Passes the message to the LEDMorseSender object.
 *   6. Initializes the Si5351A PLL and sets the CLK0 output to target_freq.
 *
 * Example CW message: "ia/iu0szs 130yr pb14qv a3c2"
 *   where "a3c2" is the 4-hex CRC for the current minute and the Marconi salt.
 */
void SetBeaconMsg(void) {
  if (timeClient.isTimeSet()) {
    epochTime = timeClient.getEpochTime();
    stamp.getDateTime(epochTime);
    // Build "yymmddhhmm" — note: stamp.year includes the century, take the last 2 digits
    timeStamp = (String)stamp.year  +
                (String)stamp.month +
                (String)stamp.day   +
                (String)stamp.hour  +
                (String)stamp.minute;
  }

  // Compute Fletcher-16 checksum over "yymmddhhmm" + "25041874"
  // (22 characters total: 10 from the timestamp + 8 from the salt, null-terminated)
  char str[23];
  (timeStamp + salt).toCharArray(str, 22);
  uint16_t crc = checksumCalculator((uint8_t *)str, 22);

  Serial.print(timeStamp + salt + " ");
  Serial.println(crc, HEX);

  // Format the CRC as 4 zero-padded lowercase hex characters.
  // Buffer is 5 bytes: 4 hex digits + null terminator required by sprintf.
  char crcHex[5];
  sprintf(crcHex, "%04x", crc);

  // Assemble the full beacon message (all lowercase — required by the Morse library)
  cw_message = qrz + " " + message + " " + crcHex;
  Serial.println(cw_message);

  // Pass the assembled message to the LEDMorseSender
  cwtx.setup();
  cwtx.setMessage(cw_message);

  // Re-initialize the Si5351A for each transmission cycle.
  // This ensures the clock generator is in a defined state even after a
  // /setqrg or /setcal command was received since the last cycle.
  target_freq = Str2u64(qrg) * 100;  // Convert Hz → centi-Hz
  beacon.init(SI5351_CRYSTAL_LOAD_8PF, 0, 0);  // 8 pF crystal load, internal reference
  delay(5);
  beacon.set_correction(cal_factor, SI5351_PLL_INPUT_XO);  // Apply frequency correction
  delay(5);
  beacon.set_pll(SI5351_PLL_FIXED, SI5351_PLLA);           // Use fixed PLL multiplier
  delay(5);
  beacon.set_freq(target_freq, SI5351_CLK0);               // Output carrier on CLK0
  delay(5);
}


// ═════════════════════════════════════════════════════════════════════════════
// WEB PAGES (chunked HTTP transfer)
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Send one of several HTML pages using HTTP chunked transfer encoding.
 *
 * Chunked transfer avoids buffering the entire page in RAM (which would
 * quickly exhaust the ESP8266's heap). Each call to server.sendContent()
 * flushes one small chunk to the TCP socket.
 *
 * Page index:
 *   0 — Status page   (default route "/")
 *   1 — Setup page    ("/setup")
 *   2 — Settings applied confirmation
 *   3 — Wrong password error
 *   4 — (Reserved — was thermostat page)
 *   5 — (Reserved — was data charts page)
 *   6 — (Reserved — was registration page)
 *
 * @param textNumber Index of the page to send (see above)
 */
void SendHTMLchunked(uint8_t textNumber) {
  String ptr = "";

  // Disable browser caching so the status page always shows current values
  server.sendHeader("Cache-Control", "no-cache, no-store, must-revalidate");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Expires", "-1");
  server.setContentLength(CONTENT_LENGTH_UNKNOWN);
  server.send(200, "text/html", "");

  // ── Common HTML head ────────────────────────────────────────────────────
  server.sendContent(F("<!DOCTYPE html><html><head>"
                       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=0.5\">"
                       "<title>CWbeacon</title>"));
  server.sendContent(F("<style>"
                       "form {margin: 0 auto; width: 600px; padding: 1em; border: 1px solid #CCC; border-radius: 1em;}"
                       "form div + div {margin-top: 1em;}"
                       "label {display: inline-block; width: 140px; text-align: right; padding-right:5px;}"
                       ".wide {display: inline-block; width: 220px; text-align: right; padding-right:5px;}"
                       "input, textarea {font: 1em sans-serif; width: 240px; box-sizing: border-box; border: 1px solid #999;}"
                       "input, canvas {vertical-align: bottom;}"
                       "input:focus, textarea:focus {border-color: #000;}"
                       ".small {width: 60px; type=\"number\"; maxlength=\"3\"; min=\"0\"; max=\"255\";}"
                       ".setp {width: 100px; type=\"number\"; maxlength=\"3\"; min=\"-40\"; max=\"85\";}"
                       "textarea {vertical-align: top; height: 5em;}"
                       "button {margin: 1em;}"
                       ".button {background-color: "));
  server.sendContent(bgcolor);
  server.sendContent(F("; color:white;text-align: center;border-radius: .5em;}"
                       "</style></head>"
                       "<body bgcolor=\""));
  server.sendContent(bgcolor);
  server.sendContent(F("\"><center>"
                       "<div class=\"container text-center\" style=\"background-color:white; width: 660px;"
                       " border-radius: 10px; border-color: rgb(14, 99, 174); border-width: medium; border-style: solid;\">"));

  // ── Page-specific content ────────────────────────────────────────────────
  switch (textNumber)
  {
    // ── Page 0: Status page ────────────────────────────────────────────────
    case 0:
      {
        server.sendContent(F("<h1>Status of "));
        server.sendContent(sysName);
        // Time and date line from the NTP client
        ptr = "</h1><form action=\"/\" method=\"post\"><p>" +
              String(daysOfTheWeek[timeClient.getDay()]) + " " +
              timeClient.getFormattedTime() + " UTC+" +
              String(utcOffsetInSeconds / 3600) + "</p>";
        server.sendContent(ptr);

        // Wi-Fi RSSI horizontal bar rendered on an HTML5 canvas element.
        // The bar length is mapped from the RSSI range [-100 dBm … -40 dBm]
        // using a red-to-green gradient: 3 pixels per dBm, offset by +40.
        server.sendContent(F("<div><label for=\"rssi\">WiFi RSSI dBm </label>"
                             "<canvas id=\"rssi\" width=\"240\" height=\"20\" style=\"border:1px solid #999;\">"
                             "HTML5 canvas not supported!</canvas>"));
        server.sendContent(F("<script>var c=document.getElementById(\"rssi\"); var ctx=c.getContext(\"2d\");"));
        server.sendContent(F("var grd=ctx.createLinearGradient(0,0,180,0); "
                             "grd.addColorStop(0,\"red\"); grd.addColorStop(1,\"lime\");"));
        server.sendContent(F("ctx.font=\"1em sans-serif\"; ctx.textAlign=\"right\"; ctx.fillText(\""));
        server.sendContent(String(rssi));
        server.sendContent(F("\",230,16); ctx.fillStyle=grd; ctx.fillRect(0,0,"));
        server.sendContent(String(((rssi + 40) * 3) + 180)); // Bar width (px)
        server.sendContent(F(",20);</script></div>"));

        // Beacon status fields (read-only)
        server.sendContent(F("<div><label for=\"qrg\">Beacon QRG Hz</label>"
                             "<input type=\"text\" name=\"qrg\" readonly value=\""));
        server.sendContent(qrg);
        server.sendContent(F("\"></div>"));

        server.sendContent(F("<div><label for=\"wpm\">Beacon WPM</label>"
                             "<input type=\"text\" name=\"wpm\" readonly value=\""));
        server.sendContent(String(wpms[speedIndex]));
        server.sendContent(F("\"></div>"));

        server.sendContent(F("<div><label for=\"qtc\">Beacon QTC</label>"
                             "<input type=\"text\" name=\"qtc\" readonly value=\""));
        server.sendContent(cw_message);
        server.sendContent(F("\"></div>"));

        // Beacon enable/disable checkbox (read-only on the status page)
        server.sendContent(F("<div><label for=\"bea_ena\">Beacon enable</label>"
                             "<input type=\"checkbox\" id=\"bea_ena\" name=\"bea_ena\" readonly value=\"1\" "));
        server.sendContent(BeaconON ? F("checked></div>") : F("></div>"));

        // Uptime display
        server.sendContent(F("<div><label for=\"uptime\">Uptime dd:hh:mm:ss </label>"
                             "<input type=\"text\" name=\"uptime\" readonly value=\""));
        unsigned long uptime      = millis() / 1000;
        unsigned char uptimeDays    = uptime / 86400;
        unsigned char uptimeHours   = (uptime % 86400) / 3600;
        unsigned char uptimeMinutes = (uptime % 3600) / 60;
        unsigned char uptimeSeconds = uptime % 60;
        ptr = String(uptimeDays)    + ":" +
              String(uptimeHours)   + ":" +
              String(uptimeMinutes) + ":" +
              String(uptimeSeconds);
        server.sendContent(ptr);
        server.sendContent(F("\"></div>"
                             "<div>"
                             "<button class=\"button\" type=\"button\" onclick=\"window.location.href='/setup';\">SETUP</button>"
                             "<button class=\"button\" type=\"submit\">REFRESH</button>"
                             "</div></form>"));
      }
      break;

    // ── Page 1: Setup / configuration page ────────────────────────────────
    case 1:
      {
        // System name and Wi-Fi credentials
        server.sendContent(F("<h1>Setup page</h1><br>"
                             "<form action=\"/applysettings\" method=\"post\">"
                             "<div><label for=\"name\">System Name</label>"
                             "<input type=\"text\" id=\"sysname\" name=\"system_name\" "
                             "pattern=\"[a-zA-Z0-9.\\-]{3,16}\" value=\""));
        server.sendContent(sysName);
        server.sendContent(F("\"></div>"
                             "<div><label for=\"wifi_ssid\">WiFi SSID</label>"
                             "<input type=\"text\" id=\"wifissid\" name=\"wifi_ssid\" maxlength=\"32\" value=\""));
        server.sendContent(wifissid);
        server.sendContent(F("\"></div>"
                             "<div><label for=\"wifi_pwd\">WiFi PASSWORD</label>"
                             "<input type=\"password\" id=\"wifipwd\" name=\"wifi_pwd\" maxlength=\"32\" value=\""));
        if (wifipwd.isEmpty()) {
          server.sendContent(F("\"></div>"
                               "<div><label for=\"staip0\">Static IP</label>"
                               "<input class=\"small\" id=\"staip0\" name=\"staip_0\" value=\""));
        }
        else {
          server.sendContent(wifipwd);
          server.sendContent(F("\"></div>"
                               "<div><label for=\"staip0\">Static IP</label>"
                               "<input class=\"small\" id=\"staip0\" name=\"staip_0\" value=\""));
        }

        // Static IP, netmask, gateway, and DNS fields (quad-octet inputs)
        server.sendContent(String(local_IP[0]));
        server.sendContent(F("\"><input class=\"small\" id=\"staip1\" name=\"staip_1\" value=\""));
        server.sendContent(String(local_IP[1]));
        server.sendContent(F("\"><input class=\"small\" id=\"staip2\" name=\"staip_2\" value=\""));
        server.sendContent(String(local_IP[2]));
        server.sendContent(F("\"><input class=\"small\" id=\"staip3\" name=\"staip_3\" value=\""));
        server.sendContent(String(local_IP[3]));
        server.sendContent(F("\"></div><div><label for=\"netm0\">Netmask</label>"
                             "<input class=\"small\" id=\"netm0\" name=\"netm_0\" value=\""));
        server.sendContent(String(subnet[0]));
        server.sendContent(F("\"><input class=\"small\" id=\"netm1\" name=\"netm_1\" value=\""));
