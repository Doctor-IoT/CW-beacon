                             "<div><button class=\"button\" type=\"submit\">Restart the system</button></div>"
                             "</form>"));
      }
      break;

    // ── Page 3: Wrong admin password error ────────────────────────────────
    case 3:
      {
        server.sendContent(F("<h1>Wrong password!</h1><br>"
                             "<p>The admin password you entered was wrong.</p>"
                             "<p>Please go back and try again.</p>"));
