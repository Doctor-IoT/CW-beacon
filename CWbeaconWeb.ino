/**
 * @brief Convert a uint64_t integer to its decimal String representation.
 *
 * The standard Arduino String(val) constructor does not support uint64_t
 * on the ESP8266; this function provides the conversion manually.
 *
 * @param value The 64-bit unsigned integer to convert
 * @return      String of decimal digits (e.g. "1234567890")
 */
String u64ToString(uint64_t value)
{
  // Use uint8_t (unsigned) for the index to avoid -Wchar-subscripts:
  // a signed 'char' index causes a warning because negative indices are undefined.
  uint8_t Ndigits = (value > 0) ? (uint8_t)(log10((double)value) + 1) : 1;
  char temp[Ndigits + 1];
  temp[Ndigits] = 0;  // Null terminator
  for (uint8_t i = Ndigits; i--; value /= 10) {
    temp[i] = '0' + (value % 10);
  }
  return String(temp);
}

/**
 * @brief Convert a decimal digit String to a uint64_t integer.
 *
 * Parses the string left-to-right using explicit power-of-10 multiplication.
 * This is needed because String.toInt() / atoi() return only 32-bit results.
 *
 * @param text String of decimal digits (e.g. "14096950")
 * @return     Parsed uint64_t value
 */
uint64_t Str2u64(String text)
{
  unsigned int len = text.length();
  uint64_t val = 0;
  for (unsigned int i = 0; i < len; i++) {
    uint64_t multiplier = 1;
    // Compute 10^(len-i-1)
    for (char j = 0; j < (len - i - 1); j++) {
      multiplier *= 10;
    }
    val += (uint64_t)(text[i] - '0') * multiplier;
  }
  return val;
}
