// ═════════════════════════════════════════════════════════════════════════════
// WI-FI CONNECTION
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Initialize Wi-Fi and start all network services.
 *
 * Attempts to connect to the configured Wi-Fi network (STA mode) for up to
 * ~10 seconds. If the connection fails, the device creates its own Access
 * Point (SSID: CWbeacon-AP) so a browser can still reach the configuration
 * page at http://192.168.4.1/ without an external network.
 *
 * After Wi-Fi is configured, this function:
 *   - Registers all HTTP server routes
 *   - Starts the HTTP server on port 80
 *   - Enables the OTA firmware update endpoint at /update (admin-password-protected)
 */
void wifiConnection(void) {
  // Determine whether to use a static IP or DHCP.
  // All-ones (255.255.255.255) or all-zeros are treated as "use DHCP".
  if (!((local_IP[0] == 255 && local_IP[1] == 255 &&
         local_IP[2] == 255 && local_IP[3] == 255) || (local_IP[0] == 0))) {
    // Static IP configured — apply before connecting
    if (!WiFi.config(local_IP, gateway, subnet, primaryDNS, secondaryDNS)) {
      Serial.println("STA Failed to configure");
    }
  }

  Serial.print("Connecting to ");
  Serial.println(wifissid);

  // Connect with or without a password depending on the network type
  if (wifipwd.isEmpty()) {
    Serial.println("WiFi.begin(wifissid);");
    WiFi.begin(wifissid);
  }
  else {
    Serial.println("WiFi.begin(wifissid, wifipwd);");
    WiFi.begin(wifissid, wifipwd);
  }

  // Poll for connection; timeout after ~10.2 seconds
  unsigned long startTime = millis();
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
    if ((millis() - startTime) > 10200) {
      break;
    }
  }

  if (WiFi.status() == WL_CONNECTED) {
    // STA mode — successfully joined the network
    APmodeON = 0;
    Serial.println(" connected!");
    Serial.print("Local IP address: "); Serial.println(WiFi.localIP());
    Serial.print("MAC address: ");      Serial.println(WiFi.macAddress());
    WiFi.printDiag(Serial);
  }
  else {
    // STA connection failed — fall back to AP mode
    if (APmodeON == 0) {
      Serial.println("WiFi connection failed, switching to AP mode!");
      WiFi.softAP(APssid, APpwd);
      IPAddress IP = WiFi.softAPIP();
      Serial.print("AP IP address: "); Serial.println(IP);
      Serial.println(WiFi.localIP());
      APmodeON = 1;
    }
    else {
      Serial.println("AP mode ON!");
    }
  }

  // ── Register HTTP routes ────────────────────────────────────────────────
  server.on("/",              handle_OnConnect);
  server.on("/setup",         handle_setup);
  server.on("/applysettings", handle_applysettings);
  server.on("/restart",       handle_restart);
  server.onNotFound(handle_NotFound);
  server.begin();
  Serial.println("HTTP server started");

  // ── OTA firmware update server ──────────────────────────────────────────
  // Accessible at http://<device-ip>/update; protected by the admin password
  String tempStr = adminpwd;
  const char* updatePWD = tempStr.c_str();
  httpUpdater.setup(&server, "/update", "admin", updatePWD);
  Serial.print("HTTP Update Server ready! Open http://");
  if (APmodeON)
    Serial.print(WiFi.softAPIP());
  else
    Serial.print(WiFi.localIP());
  Serial.println("/update in your browser");
}


// ═════════════════════════════════════════════════════════════════════════════
// CRC-16 (FLETCHER-16 VARIANT)
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Compute a Fletcher-16 variant checksum over a byte array.
 *
 * Standard Fletcher-16 uses modulo 65535; this implementation uses modulo 255
 * for both accumulators, which produces a different (but still valid) 16-bit
 * output in the range [0x0000, 0xFEFE].
 *
 * The checksum is used to authenticate each CW transmission:
 *   input  = "yymmddhhmm" + "25041874"  (UTC timestamp + Marconi's birthday salt)
 *   output = 4 hex characters appended to the beacon message
 *
 * Any receiver that knows the salt and the UTC time can recompute the checksum
 * and verify that the transmission is genuine and time-stamped correctly.
 *
 * @param data   Pointer to the input byte array
 * @param length Number of bytes to process
 * @return       16-bit checksum: high byte = sum2, low byte = sum1
 */
uint16_t checksumCalculator(uint8_t * data, uint16_t length) {
  uint16_t curr_crc = 0x0000;
  uint8_t sum1 = (uint8_t) curr_crc;
  uint8_t sum2 = (uint8_t)(curr_crc >> 8);
  for (int index = 0; index < length; index++) {
    sum1 = (sum1 + data[index]) % 255;
    sum2 = (sum2 + sum1) % 255;
  }
  return (sum2 << 8) | sum1;
}


// ═════════════════════════════════════════════════════════════════════════════
// EEPROM HELPER FUNCTIONS
// ═════════════════════════════════════════════════════════════════════════════

/**
 * @brief Write a 64-bit unsigned integer to EEPROM in big-endian byte order.
 *
 * Stores 8 bytes starting at startAdr: most-significant byte first.
 * Big-endian order is preserved when reading back with simple byte-shift
 * reconstruction in varPreset().
 *
 * @param val      Value to write
 * @param startAdr Starting EEPROM address (must have 8 bytes available)
 */
void saveU64eeprom(uint64_t val, unsigned int startAdr)
{
  EEPROM.begin(EEmemLen);
  for (unsigned char i = 0; i < 8; i++) {
    unsigned char val0 = val & 0x00000000000000ffULL;
    EEPROM.write(startAdr + 7 - i, val0);  // Write least-significant byte last (big-endian)
    val = val >> 8;
  }
  EEPROM.end();
}

/**
 * @brief Write a single byte to EEPROM.
 *
 * @param val     Byte value to write
 * @param address EEPROM address to write to
 */
void saveByte2eeprom(unsigned char val, int address)
{
  EEPROM.begin(EEmemLen);
  EEPROM.write(address, val);
  EEPROM.end();
}

/**
 * @brief Write a null-terminated String to a fixed-length EEPROM field.
 *
 * Writes the string's characters up to the null terminator, then pads
 * the remaining bytes in the field with null (0x00). This ensures that
 * a shorter replacement value never leaves stale characters from a
 * previous longer value.
 *
 * @param str2Write String to store
 * @param startAdr  Starting EEPROM address
 * @param strLen    Total field length in bytes (including padding)
 */
void saveString2eeprom(String str2Write, int startAdr, int strLen)
{
  int i = 0;
  EEPROM.begin(EEmemLen);
  // Write string characters until the null terminator
  while (str2Write[i] != 0) {
    EEPROM.write(startAdr + i, str2Write[i]);
    i++;
  }
  // Zero-fill the remainder of the field
  while (i < strLen) {
    EEPROM.write(startAdr + i, 0);
    i++;
  }
  EEPROM.end();
}


// ═════════════════════════════════════════════════════════════════════════════
// STARTUP VARIABLE PRELOAD FROM EEPROM
// ═════════════════════════════════════════════════════════════════════════════
/**
 * @brief Read all configuration from EEPROM into RAM variables at boot.
 *
 * Reads the full 512-byte EEPROM image into a local buffer once, then
 * extracts each parameter from its fixed address range. This avoids
 * repeated EEPROM.begin() / EEPROM.end() calls during parsing.
 *
 * Parameters loaded: admin password, feature enable flags, Wi-Fi SSID and
 * password, background color, Telegram token, static IP / netmask / gateway /
 * DNS, system name, beacon message, call sign, carrier frequency, authorized
 * Telegram user IDs, calibration factor, WPM, and GET period.
 */
void varPreset(void)
{
  char    EEmemData[EEmemLen];   // Full EEPROM image
  int     i;
  char    tempC;
  String  st;
  st.reserve(48);
  bool    empty = true;

  // ── Bulk read ───────────────────────────────────────────────────────────
  EEPROM.begin(EEmemLen);
  for (int i = 0; i < EEmemLen; i++) {
    EEmemData[i] = char(EEPROM.read(i));
  }
  EEPROM.end();

  // ── Password-changed flag ───────────────────────────────────────────────
  // '1' means the password has been changed via the web UI; any other value
  // causes varPreset() to revert to the factory default "12345678".
  pwdChanged = EEmemData[pwdChangedAdr];

  // ── Admin password ──────────────────────────────────────────────────────
  empty = true;
  st    = "";
  i     = 0;
  while (i < admPwdLen) {
    tempC = EEmemData[admPwdAdr + i];
    if (tempC == '\0') {
      if (i > 0) empty = false;
      i = admPwdLen;
    }
    else {
      st += tempC;
    }
    i++;
  }
  // Use the stored password only if it has been deliberately set
  if (empty == true || pwdChanged != '1') {
    adminpwd = "12345678";   // Factory default
  }
  else {
    adminpwd = st;
  }
  Serial.print("Admin pwd: "); Serial.print(adminpwd); Serial.println(".");

  // ── Feature enable flags ────────────────────────────────────────────────
  // Byte at sensorsEnableAdr: bit0 = Telegram bot enable
  unsigned char Enables = EEmemData[sensorsEnableAdr];
  TGbotEnable = Enables & 0x01;

  // ── Wi-Fi SSID (stored network name, STA mode) ──────────────────────────
  i  = 0;
  st = "";
  while (i < APssidLen) {
    tempC = EEmemData[APssidAdr + i];
    if (tempC == '\0') { i = APssidLen; }
    else                { st += tempC; }
    i++;
  }
  wifissid = (st.length() > 0) ? st : "";
  Serial.print("AP SSID: "); Serial.print(wifissid); Serial.println(".");

  // ── Wi-Fi password ──────────────────────────────────────────────────────
  i  = 0;
  st = "";
  while (i < APpwdLen) {
    tempC = EEmemData[APpwdAdr + i];
    if (tempC == '\0') { i = APpwdLen; }
    else                { st += tempC; }
    i++;
  }
  wifipwd = (st.length() > 0) ? st : "";
  Serial.print("AP PWD: "); Serial.print(wifipwd); Serial.println(".");

  // ── HTML background color ───────────────────────────────────────────────
  // Must start with '#'; fall back to the default blue if missing or malformed
  empty = true;
  i     = 0;
  st    = "";
  while (i < bgcolorLen) {
    tempC = EEmemData[bgcolorAdr + i];
    if (tempC == '\0') {
      if (i > 0) empty = false;
      i = bgcolorLen;
    }
    else {
      st += tempC;
    }
    i++;
    if (i == bgcolorLen) empty = false;
  }
  Serial.print("BG color: ");
  if (empty || st.charAt(0) != '#') {
    bgcolor = "#1e73be";   // Default: DockerBlue
  }
  else {
    bgcolor = st;
  }
  Serial.print(bgcolor); Serial.println(".");

  // ── Telegram Bot token ──────────────────────────────────────────────────
  // The token field is read as-is (no null-termination check) because the
  // token always fills the full tokenLen bytes.
  i  = 0;
  st = "";
  while (i < tokenLen) {
    st += EEmemData[tokenAdr + i];
    i++;
  }
  token = (st.length() > 0) ? st : "";
  Serial.print("TG token: "); Serial.print(token); Serial.println(".");

  // ── Static IP configuration ─────────────────────────────────────────────
  // Each IPv4 address is stored as 4 consecutive bytes (one octet each).
  local_IP[0]     = EEmemData[staticIpAdr];
  local_IP[1]     = EEmemData[staticIpAdr + 1];
  local_IP[2]     = EEmemData[staticIpAdr + 2];
  local_IP[3]     = EEmemData[staticIpAdr + 3];
  subnet[0]       = EEmemData[netMaskAdr];
  subnet[1]       = EEmemData[netMaskAdr + 1];
  subnet[2]       = EEmemData[netMaskAdr + 2];
  subnet[3]       = EEmemData[netMaskAdr + 3];
  gateway[0]      = EEmemData[gatewayIpAdr];
  gateway[1]      = EEmemData[gatewayIpAdr + 1];
  gateway[2]      = EEmemData[gatewayIpAdr + 2];
  gateway[3]      = EEmemData[gatewayIpAdr + 3];
  primaryDNS[0]   = EEmemData[dnsIp0Adr];
  primaryDNS[1]   = EEmemData[dnsIp0Adr + 1];
  primaryDNS[2]   = EEmemData[dnsIp0Adr + 2];
  primaryDNS[3]   = EEmemData[dnsIp0Adr + 3];
  secondaryDNS[0] = EEmemData[dnsIp1Adr];
  secondaryDNS[1] = EEmemData[dnsIp1Adr + 1];
  secondaryDNS[2] = EEmemData[dnsIp1Adr + 2];
  secondaryDNS[3] = EEmemData[dnsIp1Adr + 3];

  // ── System name ─────────────────────────────────────────────────────────
  i  = 0;
  st = "";
  while (i < sysNameLen) {
    tempC = EEmemData[sysNameAdr + i];
    if (tempC == '\0') { i = sysNameLen; }
    else                { st += tempC; }
    i++;
  }
  sysName = (st.length() > 0) ? st : "";
  Serial.print("Name: "); Serial.print(sysName); Serial.println(".");

  // ── Beacon message (QTC payload) ────────────────────────────────────────
  empty = true;
  i     = 0;
  st    = "";
  while (i < messageLen) {
    tempC = EEmemData[messageAdr + i];
    if (tempC == '\0') {
      if (i > 0) empty = false;
      i = messageLen;
    }
    else {
      st += tempC;
    }
    i++;
    if (i == messageLen) empty = false;
  }
  message = empty ? "" : st;
  Serial.print("Beacon msg: "); Serial.print(message); Serial.println(".");

  // ── Call sign (QRZ) ─────────────────────────────────────────────────────
  empty = true;
  i     = 0;
  st    = "";
  while (i < qrzLen) {
    tempC = EEmemData[qrzAdr + i];
    if (tempC == '\0') {
      if (i > 0) empty = false;
      i = qrzLen;
    }
    else {
      st += tempC;
    }
    i++;
    if (i == qrzLen) empty = false;
  }
  qrz = empty ? "" : st;
  Serial.print("QRZ: "); Serial.print(qrz); Serial.println(".");

  // ── Carrier frequency string (QRG, in Hz as text) ───────────────────────
  empty = true;
  i     = 0;
  st    = "";
  while (i < qrgLen) {
    tempC = EEmemData[qrgAdr + i];
    if (tempC == '\0') {
      if (i > 0) empty = false;
      i = qrgLen;
    }
    else {
      st += tempC;
    }
    i++;
    if (i == qrgLen) empty = false;
  }
  qrg = empty ? "" : st;
  Serial.print("QRG: "); Serial.print(qrg); Serial.println(".");
  target_freq = Str2u64(qrg) * 100;  // Pre-compute centi-Hz value for the Si5351

  // ── Telegram authorized user IDs (big-endian uint64_t, 8 bytes each) ────
  // Reconstruction: read 8 bytes and shift-accumulate MSB first
  for (int u = 0; u < 4; u++) {
    unsigned int base = user0Adr + u * 8;
    userid[u] = EEmemData[base];
    for (int j = 1; j < 8; j++) {
      userid[u] = (userid[u] << 8) + (unsigned char)EEmemData[base + j];
    }
  }

  // ── Frequency calibration factor ────────────────────────────────────────
  {
    String fcal = "";
    i  = 0;
    st = "";
    while (i < fcalLen) {
      tempC = EEmemData[fcalAdr + i];
      if (tempC == '\0') { i = fcalLen; }
      else                { st += tempC; }
      i++;
    }
    fcal       = (st.length() > 0) ? st : "0";
    cal_factor = fcal.toInt();
    Serial.print("Cal. factor: "); Serial.print(fcal); Serial.println(".");
  }

  // ── Morse speed (WPM) ────────────────────────────────────────────────────
  {
    String wpm = "";
    i  = 0;
    st = "";
    while (i < wpmLen) {
      tempC = EEmemData[wpmAdr + i];
      if (tempC == '\0') { i = wpmLen; }
      else                { st += tempC; }
      i++;
    }
    wpm     = (st.length() > 0) ? st : "1";
    wpms[0] = wpm.toFloat();
    Serial.print("WPM: "); Serial.print(wpm); Serial.println(".");
  }

}



