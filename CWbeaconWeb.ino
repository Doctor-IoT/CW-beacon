      break;

    // ── Pages 4–6: Reserved (unused) ──────────────────────────────────────
    case 4:
    case 5:
    case 6:
    default:
      break;
  }

  // ── Common HTML footer ───────────────────────────────────────────────────
  server.sendContent(F("<br><p>"));
  server.sendContent(firmwareRev);
  server.sendContent(F("</p><p>Made by IoT Lab @ IIS Cassata Gattapone, Gubbio, Italy<br>"
